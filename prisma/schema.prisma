// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  DOKTER
  PENDAFTARAN
}

enum Gender {
  L
  P
}

enum Status {
  WAITING
  CHECKED
  COMPLETED
  CANCELED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorVisits       Visits[] @relation("DoctorVisits")
  receptionistVisits Visits[] @relation("ReceptionistVisits")

  medicalRecords medicalRecord[]
}

model Patients {
  id            Int      @id @default(autoincrement())
  name          String   
  age           Int
  gender        Gender
  recordNumber  String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visits Visits[]
}

model Visits {
  id            Int      @id @default(autoincrement())
  patientId     Int
  doctorId      Int
  recepsionistId   Int
  visitDate     DateTime
  description   String   @db.Text
  status        Status   @default(WAITING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       Patients @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User     @relation("DoctorVisits", fields: [doctorId], references: [id])
  recepsionist  User     @relation("ReceptionistVisits", fields: [recepsionistId], references: [id])

  medicalRecords medicalRecord[]
}

model medicalRecord {
  id            Int      @id @default(autoincrement())
  doctorId      Int
  visitId       Int
  diagnosis     String   @db.Text
  actionPlan    String   @db.Text
  receipt       String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [doctorId], references: [id])
  visit         Visits   @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

